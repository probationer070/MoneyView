# MoneyView Environment Variables (template)
# Copy this file to config/.env and fill with your own values.

# Korean Bank ECOS API
ECOS_API_KEY=

# Federal Reserve (St. Louis Fed) FRED API
FRED_API_KEY=

# Nasdaq Data Link
NASDAQ_API_KEY=

# REB
REB_API_KEY=

# KOSIS
KOSIS_API_KEY=

# CoinMarketCap API
CMC_API_KEY=

# App settings (local development)
API_HOST=127.0.0.1
API_PORT=8000
DB_PATH=data/processed/moneyview.db
DATA_ROOT=data
