# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright writes .last-run.json plus a directory of traces and screenshots
# per failing test into test-results/ on EVERY run. `.last-run.json` was tracked
# (committed in 5fdd826), so every `npm run test:e2e` dirtied the working tree
# and the file was one `git add -A` away from being committed with unrelated
# work. It is machine-local state -- Playwright reads it for `--last-failed`.
# Only test-results/ is listed: this config uses `reporter: "list"`, so
# playwright-report/ and blob-report/ are never produced here.
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
