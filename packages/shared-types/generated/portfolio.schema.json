          "enum": [
            "daily",
            "monthly"
          ],
          "title": "ReturnFrequencyEnum",
          "type": "string"
        },
        "RiskMethodEnum": {
          "enum": [
            "historical"
          ],
          "title": "RiskMethodEnum",
          "type": "string"
